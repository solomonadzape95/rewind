# Rewind runs with NONE of these set: local CockroachDB, local Ollama models.
# Every line below is opt-in.

# ---- database ----------------------------------------------------------------
# Local default. For Cloud, use the string printed by infra/provision.sh.
# DATABASE_URL=postgresql://root@localhost:26257/rewind?sslmode=disable

# Forensic horizon, in seconds. Applied to the rewind database AND the system
# ranges that historical name resolution reads — the effective horizon is the
# minimum of the two, so both must be widened. 7 days.
# REWIND_GC_TTL=604800

# ---- CockroachDB Cloud Managed MCP Server ------------------------------------
# When set, the AGENT reads memory through MCP tools instead of a direct SQL
# connection. Forensics keeps its own connection either way.
# Both come from the console: Connect -> Model Context Protocol (MCP).
# The cluster id is the `mcp-cluster-id` header value and is always required;
# the endpoint routes by cluster, so a valid token alone is not enough.
# CRDB_MCP_CLUSTER_ID=
# CRDB_MCP_TOKEN=
# CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
# REWIND_MCP=1                      # force the MCP path without a token

# ---- models ------------------------------------------------------------------
# ollama (default) | openai | bedrock | offline
# REWIND_PROVIDER=ollama
# REWIND_MODEL_ID=qwen2.5:7b
# REWIND_EMBED_MODEL=nomic-embed-text

# Must match the model's output width. Changing it requires `pnpm db:reset` —
# the schema's VECTOR width is fixed at init and a mismatch is rejected on
# insert rather than silently corrupting search. nomic 768, Titan V2 1024.
# REWIND_EMBED_DIM=768

# OpenAI-compatible providers (Groq, OpenRouter, DeepSeek, Together)
# REWIND_PROVIDER=openai
# REWIND_BASE_URL=https://api.groq.com/openai/v1
# REWIND_API_KEY=

# Claude on Bedrock (paid, per token). Claude extracts beliefs; Titan V2 embeds.
# The only provider the ingestion Lambda can reach without extra credentials.
# REWIND_PROVIDER=bedrock
# AWS_REGION=us-east-1
# REWIND_EMBED_DIM=1024                 # Titan V2 default; 256 and 512 also valid
# REWIND_MODEL_ID=anthropic.claude-opus-5
# REWIND_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Deterministic stubs, no model at all. For developing the forensic machinery.
# Decisions produced this way tag themselves in the rationale and must never
# appear in the demo.
# REWIND_OFFLINE=1
